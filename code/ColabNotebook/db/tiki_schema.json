      ],
      "definition": "CREATE VIEW products_with_price AS\n        SELECT \n            p.product_id,\n            p.name,\n            p.description,\n            p.brand_id,\n            p.category_id,\n            p.seller_id,\n            COALESCE(b.brand_name, 'Unknown') as brand_name,\n            COALESCE(c.category_name, 'Unknown') as category_name,\n            COALESCE(pr.current_price, 0) as price,\n            COALESCE(pr.original_price, 0) as original_price,\n            COALESCE(pr.current_price, 0) as current_price,\n            COALESCE(pr.quantity_sold, 0) as quantity_sold,\n            COALESCE(r.rating_average, 0) as rating_average,\n            COALESCE(r.review_count, 0) as review_count,\n            COALESCE(r.favourite_count, 0) as favourite_count\n        FROM products p\n        LEFT JOIN brands b ON p.brand_id = b.brand_id\n        LEFT JOIN categories c ON p.category_id = c.category_id\n        LEFT JOIN product_pricing pr ON p.product_id = pr.product_id\n        LEFT JOIN product_reviews r ON p.product_id = r.product_id",
